# The ELAN I2C touchpad on the Victus powers up in "mouse mode" (report 1,
# relative X/Y only). Linux binds the generic hid-multitouch driver, which
# does not send the vendor feature report that switches the controller into
# PTP/absolute mode (report 4, real finger coordinates). hid-elan would do it,
# but this PID (04F3:321A) is not in its ID table. Without the switch,
# libinput gets no ABS_MT events and two-finger scrolling cannot work.
#
# Two boot races are handled here. The ACPI/I2C device sometimes does not bind
# to i2c_hid_acpi by itself, so the script forces that bind if no HID node shows
# up. Then the controller is not always ready when its HID node first appears:
# an early feature-report write can succeed at the ioctl level but be ignored.
# The switch is therefore retried and only reported successful once the driver
# has come back with a fresh HID node.
#
# The controller keeps advertising ABS_MT capability bits even while it is
# sending mouse reports, so capability bits cannot be used to detect the mode.
# The switch is forced every time: on boot, on resume, on udev re-enumeration,
# and by a watchdog that watches the mouse collection for relative reports and
# repairs a silent flip back to mouse mode without a reboot. A short timestamp
# guard and a lock stop the rebind's own add event from looping.
{
  config,
  lib,
  pkgs,
  ...
}: let
  cfg = config.services.victus.elanTouchpadPtp;

  switchScript = pkgs.writeText "elan-ptp-switch.py" ''
    import fcntl
    import glob
    import os
    import select
    import struct
    import sys
    import time

    HID_GLOB = "/sys/bus/hid/devices/0018:04F3:321A.*"
    I2C_DEVICE = "/sys/bus/i2c/devices/i2c-ELAN0788:00"
    I2C_DRIVER = "/sys/bus/i2c/drivers/i2c_hid_acpi"
    LOCK = "/run/elan-ptp-mode.lock"
    STAMP = "/run/elan-ptp-mode.done"
    # Enough to absorb the add event generated by our own driver rebind, but
    # short enough that a suspend/resume a minute later still forces a switch.
    GUARD_SECONDS = 15
    # Feature report 3: ELAN's vendor command to enable PTP/absolute mode.
    MAGIC = bytes([0x03, 0x33, 0x03, 0x06, 0x00, 0x05, 0x00, 0x03, 0x03, 0x00])

    _last_bind_attempt = 0.0

    def log(message):
        print("elan-ptp: " + message, flush=True)

    def hid_device():
        matches = sorted(glob.glob(HID_GLOB))
        return matches[0] if matches else None

    def hidraw_node(hid):
        nodes = glob.glob(hid + "/hidraw/hidraw*")
        return "/dev/" + os.path.basename(nodes[0]) if nodes else None

    def ensure_i2c_bound():
        # This ACPI/I2C device occasionally fails to auto-bind at boot; without
        # i2c_hid_acpi there is no HID node at all for the mode switch below.
        global _last_bind_attempt
        if not os.path.isdir(I2C_DEVICE) or os.path.exists(I2C_DEVICE + "/driver"):
            return
        if time.monotonic() - _last_bind_attempt < 2:
            return
        _last_bind_attempt = time.monotonic()
        try:
            with open(I2C_DRIVER + "/bind", "w") as handle:
                handle.write(os.path.basename(I2C_DEVICE))
            log("bound ELAN I2C device to i2c_hid_acpi")
        except OSError as error:
            log("i2c_hid_acpi bind failed: " + str(error))

    def wait_for_hid(timeout):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            ensure_i2c_bound()
            hid = hid_device()
            if hid and hidraw_node(hid):
                return hid
            time.sleep(0.25)
        return None

    def set_feature(node, payload):
        request = (3 << 30) | (len(payload) << 16) | (ord("H") << 8) | 6
        with open(node, "rb+", buffering=0) as handle:
            fcntl.ioctl(handle.fileno(), request, bytearray(payload), True)

    def rebind(hid):
        name = os.path.basename(hid)
        driver = os.path.basename(os.readlink(hid + "/driver"))
        base = "/sys/bus/hid/drivers/" + driver
        with open(base + "/unbind", "w") as handle:
            handle.write(name)
        time.sleep(0.5)
        with open(base + "/bind", "w") as handle:
            handle.write(name)

    def acquire_lock():
        # The boot/service unit, the udev rule and the watchdog can run at the
        # same time; whichever loses the race lets the winner do the switch.
        handle = open(LOCK, "w")
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            handle.close()
            return None
        return handle

    def switched_recently():
        # Only the add event caused by our own rebind is suppressed here.
        try:
            return time.time() - os.path.getmtime(STAMP) < GUARD_SECONDS
        except OSError:
            return False

    def mark_switch():
        with open(STAMP, "w") as handle:
            handle.write("1\n")

    def force_switch():
        if acquire_lock() is None:
            log("another ELAN switch is already running")
            return 0

        if switched_recently():
            log("switched recently; skipping rebind loop")
            return 0

        deadline = time.monotonic() + 180
        attempt = 0
        while time.monotonic() < deadline:
            remaining = deadline - time.monotonic()
            hid = wait_for_hid(min(10, remaining))
            if not hid:
                log("ELAN HID device is not ready yet")
                continue

            attempt += 1
            node = hidraw_node(hid)
            log("switch attempt " + str(attempt) + " via " + node)
            mark_switch()
            try:
                set_feature(node, MAGIC)
                time.sleep(0.3)
                rebind(hid)
            except OSError as error:
                log("switch attempt failed: " + str(error))
                time.sleep(1)
                continue

            # The controller can ignore an early write. Only trust the driver
            # coming back with a fresh HID node before reporting success.
            for _ in range(40):
                new_hid = hid_device()
                if new_hid and hidraw_node(new_hid):
                    log("PTP mode switched after " + str(attempt) + " attempt(s)")
                    return 0
                time.sleep(0.25)
            log("report sent but HID device did not come back; retrying")

        log("timed out waiting for ELAN PTP mode")
        return 1

    def mouse_event_node():
        # In PTP mode the Mouse collection is silent. Relative reports here are
        # the one reliable sign that the controller has flipped back to mouse
        # mode; the ABS_MT capability bits are present in both modes.
        pattern = HID_GLOB + "/input/input*/event*/device/capabilities/rel"
        for caps in glob.glob(pattern):
            try:
                bits = int(open(caps).read().split()[0], 16)
            except (OSError, ValueError, IndexError):
                continue
            if bits & 1:  # REL_X
                return "/dev/input/" + os.path.basename(
                    caps[: -len("/device/capabilities/rel")]
                )
        return None

    def watch():
        log("watchdog started")
        quiet_until = time.monotonic() + 5
        while True:
            node = mouse_event_node()
            if not node:
                time.sleep(2)
                continue
            try:
                stream = open(node, "rb", buffering=0)
            except OSError:
                time.sleep(2)
                continue

            count = 0
            window = time.monotonic()
            while True:
                ready, _, _ = select.select([stream], [], [], 1.0)
                now = time.monotonic()
                if now - window >= 2.0:
                    count = 0
                    window = now
                if not ready:
                    continue
                data = stream.read(24)
                if len(data) != 24:
                    break
                _, _, etype, code, _ = struct.unpack("llHHi", data)
                # A few stray REL events can arrive while the driver settles;
                # require a burst before treating them as a real mode flip.
                if etype == 2 and code in (0, 1):
                    count += 1
                    if count >= 8 and now > quiet_until and not switched_recently():
                        log("mouse-mode reports detected; forcing PTP switch")
                        stream.close()
                        force_switch()
                        quiet_until = time.monotonic() + 8
                        break
            stream.close()

    if "--watch" in sys.argv:
        watch()
        raise SystemExit(0)

    raise SystemExit(force_switch())
  '';

  execStart = "${pkgs.python3}/bin/python3 ${switchScript}";

  sleepTargets = ["suspend.target" "hibernate.target" "hybrid-sleep.target"];
in {
  options.services.victus.elanTouchpadPtp.enable = lib.mkEnableOption ''
    switch the HP Victus ELAN touchpad into PTP mode so two-finger scrolling works
  '';

  config = lib.mkIf cfg.enable {
    boot.kernelModules = ["hid_multitouch" "i2c_hid_acpi"];

    # Re-enumeration (suspend/resume, driver rebind, a late I2C probe) can put
    # the controller back into mouse mode. Repair it at the device level, not
    # only at boot. The script's timestamp guard absorbs its own rebind add
    # event, and the lock serialises this with the oneshot units below.
    services.udev.extraRules = ''
      ACTION=="add", SUBSYSTEM=="hid", ATTRS{id/vendor}=="04f3", ATTRS{id/product}=="321a", RUN+="${execStart}"
    '';

    systemd.services.elan-ptp-mode = {
      description = "Enable PTP mode on the ELAN touchpad (two-finger scroll)";
      wantedBy = ["multi-user.target"];
      after = ["systemd-modules-load.service" "systemd-udev-settle.service"];
      wants = ["systemd-modules-load.service"];

      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStart = execStart;
        TimeoutStartSec = 240;
      };
    };

    # The pad can fall back to mouse mode across suspend; this is idempotent.
    systemd.services.elan-ptp-mode-resume = {
      description = "Restore ELAN touchpad PTP mode after suspend";
      wantedBy = sleepTargets;
      after = sleepTargets;
      serviceConfig = {
        Type = "oneshot";
        ExecStart = execStart;
        TimeoutStartSec = 240;
      };
    };

    # A silent flip back to mouse mode produces no udev add event, so watch the
    # mouse collection for relative reports and repair it when it happens.
    systemd.services.elan-ptp-watch = {
      description = "Watch ELAN touchpad for mouse-mode fallback";
      wantedBy = ["multi-user.target"];
      after = ["elan-ptp-mode.service"];

      serviceConfig = {
        Type = "simple";
        ExecStart = "${execStart} --watch";
        Restart = "always";
        RestartSec = 2;
      };
    };
  };
}
