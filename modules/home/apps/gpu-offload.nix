{
  host,
  lib,
  pkgs,
  ...
}: let
  # The Victus has no MUX: the panel is wired to the Intel iGPU, so the
  # compositor renders on i915 and every application inherits that EGL device.
  # Anything that should render or compute on the RTX 3050 has to be pointed at
  # it explicitly with `nvidia-offload` (generated by
  # hardware.nvidia.prime.offload.enableOffloadCmd in the host config).
  #
  # Shadow the stock .desktop files instead of rewriting them: a file with the
  # same name in ~/.local/share/applications wins over the one shipped inside
  # the package, and patching the upstream file keeps MimeType, Keywords and
  # actions in sync with whatever the package installs.
  gpuEntry = name: pkg: bin: let
    src = "${pkg}/share/applications/${name}.desktop";
    patched =
      lib.replaceStrings
      ["\nExec=${bin}"]
      ["\nExec=nvidia-offload ${bin}"]
      (builtins.readFile src);
  in
    assert lib.assertMsg (lib.hasInfix "Exec=nvidia-offload" patched)
    "${name}.desktop has no 'Exec=${bin}' line to patch"; {".local/share/applications/${name}.desktop".text = patched;};
in
  lib.mkIf (host == "victus") {
    home.file =
      gpuEntry "org.kde.kdenlive" pkgs.kdePackages.kdenlive "kdenlive"
      // gpuEntry "org.shotcut.Shotcut" pkgs.shotcut "shotcut"
      // gpuEntry "gimp" pkgs.gimp "gimp-3.2"
      // gpuEntry "com.obsproject.Studio" pkgs.obs-studio "obs";
  }
